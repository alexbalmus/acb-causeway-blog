@param String message
@param String back
<main id="blog-content" class="container py-4" tabindex="-1">
    <h1 class="h3">Unable to complete this request</h1>
    <div class="alert alert-danger" role="alert">${message}</div>
    <a class="btn btn-outline-primary" href="${back}">Back to reading</a>
</main>
